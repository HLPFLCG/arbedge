# Database (Neon PostgreSQL)
# Get this from your Neon dashboard - use the serverless connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/arbedge?sslmode=require"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret for authentication (REQUIRED - minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=""

# Redis (Upstash) - for rate limiting and caching
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Stripe - for subscription payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Price IDs
STRIPE_STARTER_PRICE_ID=""
STRIPE_PROFESSIONAL_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""

# Discord (for alerts)
DISCORD_WEBHOOK_URL=""

# Telegram (for alerts)
TELEGRAM_BOT_TOKEN=""
